{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore(release): release ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "jobs-platform",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "apps/jobs-api/Directory.Build.props" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "toml", "path": "apps/ml-worker/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "apps/ml-worker/uv.lock", "jsonpath": "$.package[?(@.name.value=='ml-worker')].version" }
      ]
    }
  }
}
