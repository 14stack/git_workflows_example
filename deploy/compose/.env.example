# Copy to deploy/compose/.env to override the defaults baked into compose.yaml.
# These are local development credentials only. Never reuse them anywhere else.

# Image coordinates (set VERSION to a released version to run published images)
REGISTRY=ghcr.io/14stack/git_workflows_example
VERSION=dev

# Host ports
WEB_PORT=8080
API_PORT=5080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Credentials (local only)
POSTGRES_DB=jobs
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Seconds the worker waits before training, so the UI can show the "running" state
WORKER_SIMULATED_DELAY_SECONDS=2
